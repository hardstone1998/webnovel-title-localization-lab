# Service configuration
APP_NAME=WebNovel Title Localization API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGINS=
# Docker Compose host port
HOST_PORT=8000

# OpenAI-compatible LLM provider configuration. Any compatible endpoint is supported.
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
# Used only by DeepSeek scoring requests; 12 candidates × 8 dimensions need a larger JSON output budget.
LLM_MAX_TOKENS=16000
LLM_API_KEY=
