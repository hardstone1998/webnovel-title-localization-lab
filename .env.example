# Service configuration
APP_NAME=WebNovel Title Localization API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGINS=
# Docker Compose host port
HOST_PORT=8000

# Required only for the reviewed deepseek profile with adapter=openai-compatible.
DEEPSEEK_API_KEY=
