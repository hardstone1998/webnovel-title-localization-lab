{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/title-localization/candidate-set-1.0.schema.json",
  "title": "CandidateSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_set_id",
    "sample_id",
    "source_fingerprint",
    "created_at",
    "generation_config",
    "attempts",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_set_id": { "type": "string", "pattern": "^cset_[a-f0-9]{16}$" },
    "sample_id": { "type": "string", "minLength": 1 },
    "source_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "generation_config": { "type": "object" },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_title", "synopsis", "market_localized"],
      "properties": {
        "source_title": { "type": "integer", "minimum": 1 },
        "synopsis": { "type": "integer", "minimum": 1 },
        "market_localized": { "type": "integer", "minimum": 1 }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 12,
      "maxItems": 24,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "strategy": { "const": "source_title" } },
            "required": ["strategy"]
          },
          "minContains": 4,
          "maxContains": 12
        },
        {
          "contains": {
            "type": "object",
            "properties": { "strategy": { "const": "synopsis" } },
            "required": ["strategy"]
          },
          "minContains": 3,
          "maxContains": 6
        },
        {
          "contains": {
            "type": "object",
            "properties": { "strategy": { "const": "market_localized" } },
            "required": ["strategy"]
          },
          "minContains": 3,
          "maxContains": 6
        }
      ],
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "title",
        "normalized_title",
        "strategy",
        "ordinal",
        "provenance"
      ],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^cand_[a-f0-9]{16}$" },
        "title": { "type": "string", "minLength": 1 },
        "normalized_title": { "type": "string", "minLength": 1 },
        "strategy": {
          "enum": ["source_title", "synopsis", "market_localized"]
        },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 12 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id", "prompt_version", "parameters", "attempt", "coverage_slot"],
          "properties": {
            "model_id": { "type": "string", "minLength": 1 },
            "prompt_version": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object" },
            "attempt": { "type": "integer", "minimum": 1 },
            "coverage_slot": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
